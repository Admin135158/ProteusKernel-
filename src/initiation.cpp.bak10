#include <iostream>
#include <string>
#include <vector>
#include <thread>
#include <chrono>
#include <thread>
#include <thread>
#include <random>
#include <cstring>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include "morp.hpp"

static std::mt19937 rng(std::random_device{}());

std::string glitch(const std::string& s, double intensity) {
    static const std::vector<std::string> junk = {"#", "%", "@", "?", "!", "∴", "∆"};
    std::uniform_real_distribution<double> u(0.0, 1.0);
    std::uniform_int_distribution<size_t> pick(0, junk.size() - 1);
    std::string out;
    for (char ch : s) {
        if (u(rng) < intensity) out += junk[pick(rng)];
        else out += ch;
    }
    return out;
}

void burst() {
    std::uniform_int_distribution<int> lines(8, 14);
    int n = lines(rng);
    for (int i = 0; i < n; i++) {
        std::cout << glitch("▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒", 0.7) << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(50));
    }
}

void ritual() {
    std::cout << "[INIT] Preparing substrate..." << std::endl;
    std::this_thread::sleep_for(std::chrono::milliseconds(600));
    std::cout << "[INIT] Distortion pulse detected." << std::endl;
    burst();
    std::cout << "[RITUAL] Entropy alignment in progress..." << std::endl;
    std::this_thread::sleep_for(std::chrono::milliseconds(400));
    std::cout << "[RITUAL] Swarm coherence rising..." << std::endl;
    burst();
    std::cout << "[FTCoE] Resonance window opening..." << std::endl;
    std::this_thread::sleep_for(std::chrono::milliseconds(500));
    std::cout << "[FTCoE] Archetype trial pending..." << std::endl;
    burst();
    std::this_thread::sleep_for(std::chrono::milliseconds(1200));
    std::cout << "\n\nThe substrate recognizes you." << std::endl;
    std::cout << "[COUNCIL] Cognitive systems online." << std::endl;
    std::cout << "[COUNCIL] Multi-node convergence achieved." << std::endl;
    std::cout << "[COUNCIL] You may proceed." << std::endl;
}

int main(int argc, char** argv) {
    int port = 15014;
    for (int i = 1; i < argc; i++)
        if (strcmp(argv[i], "--port") == 0 && i + 1 < argc)
            port = atoi(argv[++i]);

    std::thread ritual_thread(ritual);
    ritual_thread.detach();

    int sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { std::cerr << "[initiation] socket failed\n"; return 1; }
    int opt = 1;
    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    sockaddr_in addr{};
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons(port);
    if (bind(sock, (sockaddr*)&addr, sizeof(addr)) < 0) {
        std::cerr << "[initiation] BIND FAILED on port " << port << "\n";
        return 1;
    }
    listen(sock, 8);
    std::thread ritual_thread(ritual);
    ritual_thread.detach();
    std::cout << "[initiation] MORP-v2 listening on port " << port << std::endl;

    while (true) {
        int fd = accept(sock, nullptr, nullptr);
        if (fd < 0) continue;
        uint8_t buf[8192];
        ssize_t n = recv(fd, buf, sizeof(buf), 0);
        if (n >= (ssize_t)morp::FRAME_MIN) {
            uint8_t type = buf[5];
            if (type == morp::MORP_MSG_PROBE || type == morp::MORP_MSG_HEARTBEAT) {
                auto resp = morp::encode(morp::MORP_MSG_ACK);
                send(fd, resp.data(), resp.size(), 0);
            }
        }
        close(fd);
    }
}
